# Unreal Engine Ignore Files
############################
# Ignore Unreal's build, cache, and intermediate files
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# Ignore compiled assets
*.pdb
*.sdf
*.sln
*.opensdf
*.suo
*.VC.db
*.VC.opendb

# Ignore Unreal auto-generated folders
.vscode/
.idea/
_Datasmith/

# Ignore project-specific user settings
Config/DefaultEditor.ini
Config/DefaultEditorUserSettings.ini
Config/DefaultGameUserSettings.ini

# Ignore Unreal Engine Marketplace/Plugin cache
Plugins/*/Intermediate/
Plugins/*/Binaries/

# Ignore auto-generated VS Code/JetBrains Rider files
.vscode/
.idea/
.vscode/settings.json
.idea/workspace.xml

# Ignore MacOS system files
.DS_Store
.AppleDouble
.LSOverride

# Ignore Windows system files
Thumbs.db
ehthumbs.db
desktop.ini

# Ignore Unreal Engine auto-save files
*.tmp
*.log
*.bak
*.swp
*.swo
*.swn
*.dmp

# Ignore Oculus/VR Development Logs & Builds
############################
# Oculus Build/Intermediate files
Oculus/
Oculus/Cache/
Oculus/Temp/
Oculus/Logs/
Oculus/Build/
Oculus/Intermediate/

# Unreal Engine OpenXR Logs
Saved/Logs/
Saved/Temp/

# Android Build & Deployment
############################
# Ignore APK, OBB, and deployment files for Quest 2
*.apk
*.obb
*.aab
*.gradle/
Android/

# Ignore Unreal Engine-specific Git files
############################
# Ignore unneeded asset metadata
Content/*/Thumbs.db
Content/*/AssetMetaData.db

# Ignore Linux-specific system files
*.pidb
*.csproj
*.suo
*.user
*.userprefs

# Keep essential Unreal Engine files
############################
!Config/
!Content/
!Source/
!*.uproject
!*.ini
VRProject_Demo_5_1/Content/GymEAP/Levels/L_GYM_BuiltData.uasset
*_BuiltData.uasset
